#!/usr/bin/env python3
"""Azure Function App check for CheckMK.

It allows to query function invocations in App Insights and raise
alerts based on invocation count and/or invocation failures.

In the CheckMK "special agent" framework, this file is responsible to
perform the actual check against the external system, format the
output and print it with standard separators to the stdout.

This script is launched by CheckMK in a language independent way
(hence the need of the shebang), with command line arguments computed
by server_side_calls/special_agent.py.

That output will be then taken by the agent_based/azurefunctions.py.

"""

import argparse
from concurrent.futures import FIRST_EXCEPTION, ThreadPoolExecutor, wait
import json
import math
import time
from urllib.parse import quote

try:
    from cmk_addons.plugins.azurecommon.lib.client import AzureClient, AzureError
    from cmk_addons.plugins.azurecommon.lib.credentials import (
        AutoProvider, AzureCliProvider, ServicePrincipalProvider, TokenProvider,
    )
except ModuleNotFoundError as exc:
    if not exc.name or not (
        exc.name == "cmk_addons" or exc.name.startswith("cmk_addons.")
    ):
        raise
    raise SystemExit(
        "Missing dependency: install or upgrade the 'azurecommon' MKP "
        "on this Checkmk site before running azurefunctions."
    ) from exc

#
# parse cli arguments
#

parser = argparse.ArgumentParser("agent_azurefunctions")
parser.add_argument(
    '--tenant-id',
    required=False,
    type=str,
    help='Azure Tenant ID',
)
parser.add_argument(
    '--subscription-id',
    required=True,
    type=str,
    help='Azure Subscription ID',
)
parser.add_argument(
    '--resource-group',
    required=True,
    type=str,
    help='Azure Resource group name',
)
parser.add_argument(
    '--client-id',
    required=False,
    type=str,
    help='Client ID of the Azure service principal',
)
parser.add_argument(
    '--client-secret',
    required=False,
    type=str,
    help='Client secret of the Azure service principal',
)
parser.add_argument(
    '--appinsights-app-id',
    required=True,
    type=str,
    help='App ID of the Azure App Insights resource',
)
parser.add_argument(
    '--timedelta-kql',
    required=True,
    type=str,
    help='Log timedelta in KQL expression (e.g. 1d = 1 day, 6h = 6 hours, ...',
)
parser.add_argument(
    '--proxy',
    required=False,
    type=str,
    default=None,
    help='Proxy requests, for example https://my.proxy:8080',
)
parser.add_argument(
    '--max-workers',
    type=int,
    default=8,
    help='Maximum concurrent Function App discovery requests (default: 8, minimum: 1)',
)
parser.add_argument(
    '--total-timeout',
    type=float,
    default=300,
    help='Overall Azure collection budget in seconds (default: 300)',
)
auth = parser.add_mutually_exclusive_group()
auth.add_argument(
    '--credential-provider',
    choices=('service-principal', 'az-cli', 'auto'),
    default='service-principal',
    help='Authentication provider (default: service-principal)',
)
auth.add_argument(
    '--use-cli-credentials',
    required=False,
    dest='credential_provider',
    action='store_const',
    const='az-cli',
    help='Debug for local development with Az CLI credentials',
)
args = parser.parse_args()
if args.max_workers < 1:
    parser.error("--max-workers must be at least 1")
if not math.isfinite(args.total_timeout) or args.total_timeout <= 0:
    parser.error("--total-timeout must be finite and positive")
deadline = time.monotonic() + args.total_timeout

#
# login and execute log analytics workspace query
#

credential: TokenProvider
if args.credential_provider == 'az-cli':
    credential = AzureCliProvider(proxy=args.proxy)
elif args.credential_provider == 'auto':
    credential = AutoProvider(
        args.tenant_id, args.client_id, args.client_secret, proxy=args.proxy,
    )
else:
    if not all((args.tenant_id, args.client_id, args.client_secret)):
        parser.error("--tenant-id, --client-id and --client-secret are required "
                     "with service-principal authentication")
    credential = ServicePrincipalProvider(
        args.tenant_id, args.client_id, args.client_secret,
    )
client = AzureClient(credential=credential, proxy=args.proxy, deadline=deadline)


def remaining_budget():
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise AzureError("Azure Functions collection deadline exceeded")
    return remaining


def run_concurrent(tasks, max_workers):
    pool = ThreadPoolExecutor(max_workers=max_workers)
    successful = False
    try:
        futures = []
        for task in tasks:
            remaining_budget()
            futures.append(pool.submit(task))
        done, pending = wait(
            futures, timeout=remaining_budget(), return_when=FIRST_EXCEPTION,
        )
        for future in done:
            if future.exception() is not None:
                future.result()
        if pending:
            raise AzureError("Azure Functions collection deadline exceeded")
        results = [future.result() for future in futures]
        remaining_budget()
        successful = True
        return results
    finally:
        if not successful:
            client.cancel()
        pool.shutdown(wait=False, cancel_futures=True)


def discover_functions():
    sites_path = (
        f"/subscriptions/{quote(args.subscription_id, safe='')}"
        f"/resourceGroups/{quote(args.resource_group, safe='')}"
        "/providers/Microsoft.Web/sites"
    )

    def list_functions(app):
        functions = client.web.get_paged(
            f"{sites_path}/{quote(app['name'], safe='')}/functions",
        )
        specs = []
        for function in functions:
            config = function["properties"]["config"]
            binding = config["bindings"][0]
            specs.append({
                "name": config.get("name") or function["name"].rsplit("/", 1)[-1],
                "type": binding["type"],
                "schedule": binding.get("schedule"),
            })
        return app["name"], specs

    apps = [
        app for app in client.web.get_paged(sites_path)
        if "functionapp" in (app.get("kind") or "").lower().split(",")
    ]
    return dict(run_concurrent(
        (lambda app=app: list_functions(app) for app in apps),
        max_workers=args.max_workers,
    ))


def query_appinsights():
    query = f"""requests
    | extend altFuncName = tostring(customDimensions["faas.name"])
    | project
        timestamp,
        id,
        operation_Name,
        success,
        resultCode,
        duration,
        operation_Id,
        altFuncName,
        cloud_RoleName,
        invocationId=coalesce(
            tostring(customDimensions["InvocationId"]),
            tostring(customDimensions["faas.invocation_id"])
        )
    | where timestamp > ago({args.timedelta_kql})
    | order by timestamp desc
    """

    logs = client.appinsights.get(
        f"/v1/apps/{quote(args.appinsights_app_id, safe='')}/query",
        params={"query": query},
    )
    if "error" in logs:
        raise AzureError(
            f"Application Insights query failed: {json.dumps(logs['error'])}",
            details=logs["error"],
        )

    tables = logs["tables"]
    if not isinstance(tables, list):
        raise AzureError("Invalid Application Insights response: expected a list of tables")
    if not tables:
        return []
    log_lines_json = []
    cols = [c['name'] for c in tables[0]['columns']]
    for row in tables[0]['rows']:
        structured = dict(zip(cols, row, strict=True))
        log_lines_json.append(structured)
    return log_lines_json


def main():
    disc, logs = run_concurrent(
        (discover_functions, query_appinsights), max_workers=2,
    )
    print('<<<azurefunctions:sep(0)>>>')
    print(json.dumps(disc))
    for log in logs:
        print(json.dumps(log))


if __name__ == "__main__":
    main()

# next step: output is parsed and interpreted by agent_based/azurefunctions.py
