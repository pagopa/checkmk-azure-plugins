#!/usr/bin/env python3
"""Azure Monitor check for CheckMK.

It allows to query logs in Log Analytics Workspace regarding a
particular resource, and return a CheckMK status based on the count of
the logs.

The query is in the Kusto language.  See more in the docs:
https://learn.microsoft.com/en-us/azure/azure-monitor/logs/get-started-queries?tabs=kql

In the CheckMK "special agent" framework, this file is responsible to
perform the actual check against the external system, format the
output and print it with standard separators to the stdout.

This script is launched by CheckMK in a language independent way
(hence the need of the shebang), with command line arguments computed
by server_side_calls/special_agent.py.

That output will be then taken by the agent_based/azuremonitor.py.

"""

import argparse
import json
import math
import time

try:
    from cmk_addons.plugins.azurecommon.lib.client import AzureClient, AzureError
    from cmk_addons.plugins.azurecommon.lib.credentials import (
        AutoProvider, AzureCliProvider, ServicePrincipalProvider, TokenProvider,
    )
except ModuleNotFoundError as exc:
    if not exc.name or not (
        exc.name == "cmk_addons" or exc.name.startswith("cmk_addons.")
    ):
        raise
    raise SystemExit(
        "Missing dependency: install or upgrade the 'azurecommon' MKP "
        "on this Checkmk site before running azuremonitor."
    ) from exc

#
# parse cli arguments
#

parser = argparse.ArgumentParser("agent_azuremonitor")
parser.add_argument(
    '--tenant-id',
    required=False,
    type=str,
    help='Azure Tenant ID',
)
parser.add_argument(
    '--client-id',
    required=False,
    type=str,
    help='Client ID of the Azure service principal',
)
parser.add_argument(
    '--client-secret',
    required=False,
    type=str,
    help='Client secret of the Azure service principal',
)
parser.add_argument(
    '--resource-id',
    required=True,
    type=str,
    help='Azure Resource ID to query logs',
)
parser.add_argument(
    '--query',
    required=True,
    type=str,
    help='Log Analytics Query',
)
parser.add_argument(
    '--timedelta-seconds',
    required=True,
    type=str,
    help='Log timedelta in seconds',
)
parser.add_argument(
    '--count-warn',
    required=False,
    type=int,
    default=0,
    help='Number of log records found that should issue a warning alert',
)
parser.add_argument(
    '--count-crit',
    required=False,
    type=int,
    default=1,
    help='Number of log records found that should issue a critical alert',
)
parser.add_argument(
    '--custom-summary',
    required=False,
    type=str,
    default='Query retrieved {numlogs} logs',
    help='Message to show in summary. Use "{numlogs}" placeholder for n logs',
)
parser.add_argument(
    '--proxy',
    required=False,
    type=str,
    default=None,
    help='Proxy requests to Azure Monitor, for example https://my.proxy:8080',
)
parser.add_argument(
    '--credential-provider',
    choices=('service-principal', 'az-cli', 'auto'),
    default='service-principal',
    help='Authentication provider (default: service-principal)',
)
parser.add_argument(
    '--total-timeout',
    type=float,
    default=300,
    help='Overall Azure collection budget in seconds (default: 300)',
)
args = parser.parse_args()
if not math.isfinite(args.total_timeout) or args.total_timeout <= 0:
    parser.error("--total-timeout must be finite and positive")
deadline = time.monotonic() + args.total_timeout

tenant_id = args.tenant_id
client_id = args.client_id
client_secret = args.client_secret
resource_id = args.resource_id
# this is because we replaced newline with this placeholder in rulesets
kusto_query = args.query.replace('___cmk_azuremonitor_newline___', '\n')
timespan = f"PT{int(args.timedelta_seconds)}S"
count_warn = args.count_warn
count_crit = args.count_crit
custom_summary = args.custom_summary
proxy = args.proxy

#
# login and execute log analytics workspace query
#

credential: TokenProvider
if args.credential_provider == 'az-cli':
    credential = AzureCliProvider(proxy=proxy)
elif args.credential_provider == 'auto':
    credential = AutoProvider(tenant_id, client_id, client_secret, proxy=proxy)
else:
    if not all((tenant_id, client_id, client_secret)):
        parser.error("--tenant-id, --client-id and --client-secret are required "
                     "with service-principal authentication")
    credential = ServicePrincipalProvider(tenant_id, client_id, client_secret)
client = AzureClient(credential=credential, proxy=proxy, deadline=deadline)
response = client.logs.post(
    f"/v1{resource_id}/query",
    payload={"query": kusto_query, "timespan": timespan},
)

if "error" in response:
    raise AzureError(
        f"Log Analytics query failed: {json.dumps(response['error'])}",
        details=response["error"],
    )

#
# process response
#

tables = response["tables"]
if not isinstance(tables, list):
    raise AzureError("Invalid Log Analytics response: expected a list of tables")
if tables:
    table = tables[0]
    columns = [column["name"] for column in table["columns"]]
    logs = [
        json.dumps(dict(zip(columns, row, strict=True)), default=str)
        for row in table["rows"]
    ]
else:
    logs = []

# print plugin output to stdout

output_data = {
    "count_warn": args.count_warn,
    "count_crit": args.count_crit,
    "custom_summary": args.custom_summary,
    "logs": logs,
}
print('<<<azuremonitor:sep(0)>>>')
print(json.dumps(output_data))

# next step: output is parsed and interpreted by agent_based/azuremonitor.py
